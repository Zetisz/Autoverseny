<Window x:Class="Autoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoverseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="Start" Content="Start" Width="90" Height="45" Background="CornflowerBlue" Foreground="WhiteSmoke" Grid.Row="1" Click="Start_Click"/>
        <Canvas x:Name="Palya" Background="AliceBlue" Grid.Row="3">
            <Label x:Name="Auto" Width="90" Height="45" DataContext="Ferrari" Background="Crimson" Canvas.Left="20" Canvas.Top="50"/>
            <Label x:Name="Auto_2" Width="90" Height="45" DataContext="Skoda" Background="DarkSeaGreen" Canvas.Left="20" Canvas.Top="150"/>
            <Label x:Name="Auto_3" Width="90" Height="45" DataContext="Porsche" Background="DarkSlateBlue" Canvas.Left="20" Canvas.Top="250"/>
            <Label Width="20" Height="350" Background="DarkGray" Canvas.Right="30" Canvas.Top="0"/>
        </Canvas>
    </Grid>
</Window>
