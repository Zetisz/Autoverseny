<Window x:Class="Autoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoverseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="Start" Content="Start" Width="90" Height="45" Background="CornflowerBlue" Grid.Row="1" Click="Start_Click"/>
        <Canvas x:Name="Palya" Background="AliceBlue" Grid.Row="3">
            <Button x:Name="Auto" Width="90" Height="45" Background="Crimson" Canvas.Left="20" Canvas.Top="50"/>
        </Canvas>
    </Grid>
</Window>
